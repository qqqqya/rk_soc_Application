
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RK3576: Remote GDB",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/protocol_rk",
            "cwd": "${workspaceFolder}",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",

            "miDebuggerServerAddress": "192.168.100.2:2345",

            "stopAtEntry": false,
            "launchCompleteCommand": "exec-continue",

            "externalConsole": false,

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
